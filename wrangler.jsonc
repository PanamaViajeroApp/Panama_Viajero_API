{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panamaviajeroapi",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["15 8 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://panama-viajero-admin.pages.dev,https://panama-viajero-7jh.pages.dev",
    "SESSION_TTL_SECONDS": "28800"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "panama-viajero-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "panama-viajero-images"
    }
  ]
}
