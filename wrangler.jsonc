{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panama-viajero-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["15 8 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://panama-viajero-admin-j11.pages.dev,https://panama-viajero.pages.dev",
    "SESSION_TTL_SECONDS": "28800"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "panama-viajero-db",
      "database_id": "ae410d03-3d16-433a-8521-fb7bd0dc2fc6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "panama-viajero-images"
    }
  ]
}
